{
  "name": "neural-spatial-os-v2",
  "version": "0.1.0",
  "description": "A gesture-driven spatial computing shell that replaces traditional input methods with AI-assisted spatial interaction.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:watch": "webpack --mode development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "docs": "typedoc --out docs/api src",
    "start": "npm run dev",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "spatial-computing",
    "gesture-recognition",
    "hand-tracking",
    "ai",
    "3d-interface",
    "webgl",
    "three.js",
    "mediapipe"
  ],
  "author": "1deadepic-create",
  "license": "MIT",
  "dependencies": {
    "three": "^r128",
    "cannon-es": "^0.20.0",
    "@tensorflow/tfjs": "^4.10.0",
    "@tensorflow-models/hand-pose-detection": "^2.2.3",
    "@google-cloud/vision": "^3.0.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.0",
    "event-emitter": "^0.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^r128",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "typescript": "^5.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "cypress": "^13.6.0",
    "@cypress/schematic": "^2.5.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.25.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not <0.2%"
  ]
}
